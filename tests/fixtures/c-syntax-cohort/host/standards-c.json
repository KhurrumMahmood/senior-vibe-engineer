{
  "ideas": [
    {
      "id": "c-parse-if",
      "label": "Invoice parsing is syntactically enclosed by if",
      "contract": {
        "detector": {
          "kind": "ast",
          "call_matches": "^parse_invoice$",
          "enclosed_by": "if",
          "paths": ["src/**/*.c"]
        }
      },
      "activation": {"baseline": true}
    }
  ]
}
