<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>CSharpCohort.App</AssemblyName>
    <RootNamespace>CSharpCohort</RootNamespace>
    <StartupObject>CSharpCohort.Program</StartupObject>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
    <Deterministic>true</Deterministic>
    <NuGetAudit>false</NuGetAudit>
    <BaseIntermediateOutputPath>.native-build/obj/app/</BaseIntermediateOutputPath>
    <OutputPath>.native-build/bin/app/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/CSharpCohort/BillingModel.cs" />
    <Compile Include="src/CSharpCohort/BillingParser.cs" />
    <Compile Include="src/CSharpCohort/BillingTypes.cs" />
    <Compile Include="src/CSharpCohort/BillingValidator.cs" />
    <Compile Include="src/CSharpCohort/Omnibus.cs" />
    <Compile Include="src/CSharpCohort/Syntax.cs" />
    <Compile Include="src/CSharpCohort/Program.cs" />
  </ItemGroup>
</Project>
