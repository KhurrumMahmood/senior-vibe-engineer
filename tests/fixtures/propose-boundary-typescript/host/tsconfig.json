{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@orders/*": ["src/*"]
    }
  },
  "include": [
    "src/legacy/**/*.ts",
    "src/*.ts"
  ],
  "exclude": [
    "src/generated",
    "src/vendor",
    "src/**/*.test.ts"
  ]
}
