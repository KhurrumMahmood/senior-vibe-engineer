    {
      "id": "direct-change",
      "title": "Direct Change",
      "summary": "Make the narrow edit directly; avoid routing overhead.",
      "first_next": "proceed directly",
      "sequence": [
        "edit the obvious target",
        "run the narrowest meaningful verification",
        "/decide only if a durable choice appears"
      ],
      "stop": "Stop if the edit touches multiple surfaces or reveals a recurring pattern.",
      "cues": {
        "strong": [
          "typo",
          "one-line",
          "oneline",
          "trivial",
          "tiny",
          "narrow",
          "obvious"
        ],
        "normal": [
          "rename",
          "small",
          "simple",
          "docs",
          "copy",
          "text"
        ],
        "negative": [
          "architecture",
          "subsystem",
          "unknown",
          "inherited",
          "repeated",
          "concept",
          "domain",
          "glossary",
          "wide",
          "terminology"
        ]
      },
      "alternatives": [
        "bug-fix",
        "decision-capture"
      ],
      "context_exempt": true,
      "boost": {
        "narrow_signal": true,
        "cues": [
          "typo",
          "one-line",
          "oneline",
          "trivial",
          "tiny",
          "narrow",
          "obvious"
        ],
        "weight": 34,
        "rationale": "task looks narrow enough to skip routing overhead"
      }
