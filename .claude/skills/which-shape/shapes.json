    {
      "id": "task-closeout",
      "title": "Task Closeout",
      "summary": "After a body of work, size the change from the diff and run scope-matched cleanup.",
      "first_next": "/which-cleanup",
      "sequence": [
        "/which-cleanup <files | --staged | --changed-from REF | --commit SHA | --range A..B | --area NAME | --since SPEC>",
        "run the band-appropriate cleanup (checklist / scoped scout fan-out / closeout plan)",
        "/prevent-regression for any cluster that closes",
        "/converge \u2014 after-phase gate: weakest value node, single next step, stop condition, do-not-do-next"
      ],
      "stop": "Stop once the changed surface is swept, any closed cluster is guarded, and /converge has named the thread's stop condition; hand off to /triage-debt for the global picture.",
