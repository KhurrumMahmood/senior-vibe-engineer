    {
      "id": "concept-rename",
      "title": "Concept Rename",
      "summary": "Drive a glossary-worthy domain-concept rename to completion across every surface.",
      "first_next": "/rename-concept",
      "install_with": [
        "find-concept-divergence"
      ],
      "sequence": [
        "/rename-concept <old> <new> \u2014 assess the scope-gate + two-band completeness gate",
        "record the rename in the glossary (concepts.yaml superseded_by + the canonical concept's avoid: block)",
        "correct old prose + cross-tool mirrors; the gate is clean only when identifiers AND prose are"
      ],
      "stop": "Stop if it's a single local symbol with narrow blast \u2014 that's Direct Change.",
      "cues": {
        "strong": [
          "concept",
          "glossary",
          "supersede",
          "terminology",
          "deprecate"
        ],
        "normal": [
          "domain",
          "rename",
          "identifier",
          "sweep",
          "wide"
        ],
        "negative": [
          "local",
          "variable",
          "one-line",
          "oneline",
          "single",
          "trivial",
          "typo"
        ]
      },
      "alternatives": [
        "decision-capture",
        "task-closeout"
      ],
      "boost": {
        "cues": [
          "concept",
          "glossary",
          "supersede",
          "terminology",
          "deprecate"
        ],
        "weight": 30,
        "rationale": "task names a glossary-level concept or terminology change"
      }
    },
    {
      "id": "project-structure",
      "title": "Project Structure",
      "summary": "Design a near-ideal repo folder topology under framework/tool/human constraints.",
      "first_next": "/organize-project-structure",
      "sequence": [
        "/organize-project-structure \u2014 summarize folder purpose/value, abstract boundaries, and propose ideal then constrained topology",
        "separate deterministic moves from judgment/manual follow-up",
        "optionally write a /move-path plan and dry-run it; apply/check only after the report is accepted"
      ],
      "stop": "Stop if the request already names a single source/destination path \u2014 use Path Move directly.",
      "cues": {
        "strong": [
          "project-structure",
          "repo-structure",
          "repository-structure",
          "top-level",
          "information-architecture"
        ],
        "normal": [
