{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-skills:schema:which-skill-result:v1",
  "title": "WhichSkillResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "router_id",
    "normalizer_id",
    "scorer_id",
    "threshold",
    "task_sha256",
    "profile_sha256",
    "quick",
    "status",
    "candidates",
    "excluded",
    "error"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "router_id": {"const": "which-skill-overlap-v1"},
    "normalizer_id": {"const": "ascii-wordset-v1"},
    "scorer_id": {"const": "which-skill-overlap-v1"},
    "threshold": {"const": 5},
    "task_sha256": {"$ref": "#/$defs/sha256"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "quick": {"type": "boolean"},
    "status": {"enum": ["ok", "proceed_directly", "error"]},
    "candidates": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/candidate"},
      "x-sort": "descending-score-then-utf8-canonical-name-public-name"
    },
    "excluded": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/excluded"},
      "x-sort": "descending-score-then-utf8-canonical-name-public-name"
    },
    "error": {
      "type": ["string", "null"],
      "enum": [
        null,
        "invalid_task",
        "invalid_profile",
        "invalid_catalog",
        "invalid_binding",
        "incompatible_schema",
        "no_compatible_candidate",
        "internal_error"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "error"}}, "required": ["status"]},
      "then": {"properties": {"error": {"type": "string"}}, "required": ["error"]},
      "else": {"properties": {"error": {"type": "null"}}, "required": ["error"]}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "x-maxUtf8Bytes": 64
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "source_sha256", "rendered_sha256"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/id"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "rendered_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "root_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root_sha256", "bindings"],
      "properties": {
        "project_root_sha256": {"$ref": "#/$defs/sha256"},
        "bindings": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/binding"}
        }
      }
    },
    "rationale": {
      "enum": [
        "best_for_overlap",
        "not_for_overlap",
        "description_overlap",
        "name_overlap",
        "exact_tier",
        "cross_cutting_tier",
        "exact_job",
        "quick_hint",
        "skill_development_override",
        "binding_compatible"
      ]
    },
    "exclusion": {
      "enum": [
        "not_for",
        "layer_inapplicable",
        "language_incompatible",
        "framework_incompatible",
        "binding_missing",
        "binding_ambiguous",
        "binding_incompatible",
        "explicit_name_mismatch"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "public_name", "score", "applicability", "roots", "rationales"],
      "properties": {
        "canonical_name": {"$ref": "#/$defs/id"},
        "public_name": {"$ref": "#/$defs/id"},
        "score": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "applicability": {"const": "compatible"},
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/root_bindings"}
        },
        "rationales": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/rationale"}
        }
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "public_name", "score", "exclusions"],
      "properties": {
        "canonical_name": {"$ref": "#/$defs/id"},
        "public_name": {"$ref": "#/$defs/id"},
        "score": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/exclusion"}
        }
      }
    }
  }
}
