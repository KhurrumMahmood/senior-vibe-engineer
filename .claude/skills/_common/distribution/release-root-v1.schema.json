{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-skills:schema:release-root:v1",
  "title": "ReleaseRootV1",
  "description": "Externally rooted release document. Its digest is supplied out of band; this document intentionally has no self-digest field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_version",
    "bundle_index",
    "installer",
    "surface_activation_contract",
    "schemas",
    "tables"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_version": {"$ref": "#/$defs/version"},
    "bundle_index": {"$ref": "#/$defs/file"},
    "installer": {"$ref": "#/$defs/file"},
    "surface_activation_contract": {"$ref": "#/$defs/file"},
    "schemas": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/named_schema"},
      "allOf": [
        {"contains": {"properties": {"schema_id": {"const": "release-root-v1"}}, "required": ["schema_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"schema_id": {"const": "bundle-index-v1"}}, "required": ["schema_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"schema_id": {"const": "installed-manifest-v1"}}, "required": ["schema_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"schema_id": {"const": "surface-activation-contract-v1"}}, "required": ["schema_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"schema_id": {"const": "which-shape-result-v1"}}, "required": ["schema_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"schema_id": {"const": "which-skill-result-v1"}}, "required": ["schema_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"schema_id": {"const": "dispatch-pack-v1"}}, "required": ["schema_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"schema_id": {"const": "dispatch-result-v1"}}, "required": ["schema_id"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "tables": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/named_table"},
      "allOf": [
        {"contains": {"properties": {"table_id": {"const": "aliases-v1"}}, "required": ["table_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"table_id": {"const": "legacy-layouts-v1"}}, "required": ["table_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"table_id": {"const": "compatibility-v1"}}, "required": ["table_id"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$",
      "x-maxUtf8Bytes": 1024,
      "x-requireNfc": true
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "named_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "path", "size", "sha256"],
      "properties": {
        "schema_id": {
          "enum": [
            "release-root-v1",
            "bundle-index-v1",
            "installed-manifest-v1",
            "surface-activation-contract-v1",
            "which-shape-result-v1",
            "which-skill-result-v1",
            "dispatch-pack-v1",
            "dispatch-result-v1"
          ]
        },
        "path": {"$ref": "#/$defs/relative_path"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "named_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "path", "size", "sha256"],
      "properties": {
        "table_id": {"enum": ["aliases-v1", "legacy-layouts-v1", "compatibility-v1"]},
        "path": {"$ref": "#/$defs/relative_path"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
