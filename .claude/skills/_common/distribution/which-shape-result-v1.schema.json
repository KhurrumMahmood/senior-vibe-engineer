{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-skills:schema:which-shape-result:v1",
  "title": "WhichShapeResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "router_id",
    "normalizer_id",
    "task_sha256",
    "profile_sha256",
    "status",
    "candidates",
    "error"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "router_id": {"const": "which-shape-lexical-v1"},
    "normalizer_id": {"const": "ascii-wordset-v1"},
    "task_sha256": {"$ref": "#/$defs/sha256"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["ok", "clarification", "required_context", "error"]},
    "candidates": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/candidate"},
      "x-sort": "descending-score-then-utf8-shape-id"
    },
    "error": {
      "type": ["string", "null"],
      "enum": [
        null,
        "invalid_task",
        "invalid_profile",
        "invalid_registry",
        "missing_required_context",
        "incompatible_schema",
        "internal_error"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "error"}}, "required": ["status"]},
      "then": {"properties": {"error": {"type": "string"}}, "required": ["error"]},
      "else": {"properties": {"error": {"type": "null"}}, "required": ["error"]}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "x-maxUtf8Bytes": 64
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rationale": {
      "enum": [
        "strong_match",
        "normal_match",
        "negative_match",
        "boost_rule",
        "missing_context",
        "context_present"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape_id", "score", "confidence", "rationales"],
      "properties": {
        "shape_id": {"$ref": "#/$defs/id"},
        "score": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "confidence": {"enum": ["high", "medium", "low"]},
        "rationales": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/rationale"}
        }
      }
    }
  }
}
