{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-skills:schema:surface-activation-contract:v1",
  "title": "SurfaceActivationContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "surfaces"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"const": 1},
    "surfaces": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/surface"},
      "allOf": [
        {"contains": {"properties": {"surface_id": {"const": "claude-code"}}, "required": ["surface_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"surface_id": {"const": "codex"}}, "required": ["surface_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"surface_id": {"const": "augment"}}, "required": ["surface_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"surface_id": {"const": "cursor"}}, "required": ["surface_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"surface_id": {"const": "gemini"}}, "required": ["surface_id"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "short_string": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
    "nullable_short_string": {"type": ["string", "null"], "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
    "version_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"$ref": "#/$defs/short_string"},
        "upper": {"$ref": "#/$defs/short_string"}
      }
    },
    "public_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["which_shape", "which_skill", "alias_template"],
      "properties": {
        "which_shape": {"$ref": "#/$defs/short_string"},
        "which_skill": {"$ref": "#/$defs/short_string"},
        "alias_template": {"$ref": "#/$defs/short_string"}
      }
    },
    "generated_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["which_shape", "which_skill", "alias_template"],
      "properties": {
        "which_shape": {"$ref": "#/$defs/short_string"},
        "which_skill": {"$ref": "#/$defs/short_string"},
        "alias_template": {"$ref": "#/$defs/short_string"}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "parser_id", "offline_non_model"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/short_string"}},
        "parser_id": {"$ref": "#/$defs/short_string"},
        "offline_non_model": {"type": "boolean"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "temporary_activation", "terminal_wrapper", "startup_cleanup"],
      "properties": {
        "operation": {"$ref": "#/$defs/short_string"},
        "temporary_activation": {"enum": ["verified", "unsupported"]},
        "terminal_wrapper": {"$ref": "#/$defs/nullable_short_string"},
        "startup_cleanup": {"$ref": "#/$defs/nullable_short_string"}
      },
      "allOf": [
        {
          "if": {"properties": {"temporary_activation": {"const": "verified"}}, "required": ["temporary_activation"]},
          "then": {
            "properties": {
              "terminal_wrapper": {"$ref": "#/$defs/short_string"},
              "startup_cleanup": {"$ref": "#/$defs/short_string"}
            }
          },
          "else": {
            "properties": {
              "terminal_wrapper": {"type": "null"},
              "startup_cleanup": {"type": "null"}
            }
          }
        }
      ]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_worker",
        "launcher",
        "version_range",
        "selected_procedure_injection",
        "cancellation",
        "result",
        "zero_conversation_turns_proof",
        "budget_enforcement"
      ],
      "properties": {
        "fresh_worker": {"enum": ["verified", "unsupported"]},
        "launcher": {"$ref": "#/$defs/nullable_short_string"},
        "version_range": {
          "anyOf": [
            {"$ref": "#/$defs/version_bound"},
            {"type": "null"}
          ]
        },
        "selected_procedure_injection": {"$ref": "#/$defs/nullable_short_string"},
        "cancellation": {"$ref": "#/$defs/nullable_short_string"},
        "result": {"$ref": "#/$defs/nullable_short_string"},
        "zero_conversation_turns_proof": {"$ref": "#/$defs/nullable_short_string"},
        "budget_enforcement": {"$ref": "#/$defs/nullable_short_string"}
      },
      "allOf": [
        {
          "if": {"properties": {"fresh_worker": {"const": "verified"}}, "required": ["fresh_worker"]},
          "then": {
            "properties": {
              "launcher": {"$ref": "#/$defs/short_string"},
              "version_range": {"$ref": "#/$defs/version_bound"},
              "selected_procedure_injection": {"$ref": "#/$defs/short_string"},
              "cancellation": {"$ref": "#/$defs/short_string"},
              "result": {"$ref": "#/$defs/short_string"},
              "zero_conversation_turns_proof": {"$ref": "#/$defs/short_string"},
              "budget_enforcement": {"$ref": "#/$defs/short_string"}
            }
          },
          "else": {
            "properties": {
              "launcher": {"type": "null"},
              "version_range": {"type": "null"},
              "selected_procedure_injection": {"type": "null"},
              "cancellation": {"type": "null"},
              "result": {"type": "null"},
              "zero_conversation_turns_proof": {"type": "null"},
              "budget_enforcement": {"type": "null"}
            }
          }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "runtime_version",
        "projection_format",
        "public_identity",
        "generated_identity",
        "discovery",
        "activation",
        "worker"
      ],
      "properties": {
        "surface_id": {"enum": ["claude-code", "codex", "augment", "cursor", "gemini"]},
        "runtime_version": {"$ref": "#/$defs/version_bound"},
        "projection_format": {"$ref": "#/$defs/short_string"},
        "public_identity": {"$ref": "#/$defs/public_identity"},
        "generated_identity": {"$ref": "#/$defs/generated_identity"},
        "discovery": {"$ref": "#/$defs/discovery"},
        "activation": {"$ref": "#/$defs/activation"},
        "worker": {"$ref": "#/$defs/worker"}
      },
      "allOf": [
        {
          "if": {"properties": {"surface_id": {"const": "claude-code"}}, "required": ["surface_id"]},
          "then": {
            "properties": {
              "public_identity": {"const": {"which_shape": "/which-shape", "which_skill": "/which-skill", "alias_template": "/{public-name}"}},
              "generated_identity": {"const": {"which_shape": ".claude/skills/which-shape/SKILL.md", "which_skill": ".claude/skills/which-skill/SKILL.md", "alias_template": ".claude/skills/{public-name}/SKILL.md"}}
            }
          }
        },
        {
          "if": {"properties": {"surface_id": {"const": "codex"}}, "required": ["surface_id"]},
          "then": {
            "properties": {
              "public_identity": {"const": {"which_shape": "$engineering-skills:which-shape", "which_skill": "$engineering-skills:which-skill", "alias_template": "$engineering-skills:{public-name}"}},
              "generated_identity": {"const": {"which_shape": "skills/which-shape/SKILL.md", "which_skill": "skills/which-skill/SKILL.md", "alias_template": "skills/{public-name}/SKILL.md"}}
            }
          }
        },
        {
          "if": {"properties": {"surface_id": {"const": "augment"}}, "required": ["surface_id"]},
          "then": {
            "properties": {
              "public_identity": {"const": {"which_shape": "use skill which-shape", "which_skill": "use skill which-skill", "alias_template": "use skill {public-name}"}},
              "generated_identity": {"const": {"which_shape": ".augment/rules/imported/which-shape/SKILL.md", "which_skill": ".augment/rules/imported/which-skill/SKILL.md", "alias_template": ".augment/rules/imported/{public-name}/SKILL.md"}}
            }
          }
        },
        {
          "if": {"properties": {"surface_id": {"const": "cursor"}}, "required": ["surface_id"]},
          "then": {
            "properties": {
              "public_identity": {"const": {"which_shape": "use skill which-shape", "which_skill": "use skill which-skill", "alias_template": "use skill {public-name}"}},
              "generated_identity": {"const": {"which_shape": ".cursor/rules/which-shape/SKILL.mdc", "which_skill": ".cursor/rules/which-skill/SKILL.mdc", "alias_template": ".cursor/rules/{public-name}/SKILL.mdc"}}
            }
          }
        },
        {
          "if": {"properties": {"surface_id": {"const": "gemini"}}, "required": ["surface_id"]},
          "then": {
            "properties": {
              "public_identity": {"const": {"which_shape": "use skill which-shape", "which_skill": "use skill which-skill", "alias_template": "use skill {public-name}"}},
              "generated_identity": {"const": {"which_shape": ".gemini/skills/which-shape/SKILL.md", "which_skill": ".gemini/skills/which-skill/SKILL.md", "alias_template": ".gemini/skills/{public-name}/SKILL.md"}}
            }
          }
        }
      ]
    }
  }
}
