# Python bytecode and packaging
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment
.venv/

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.playwright-mcp/

# macOS
.DS_Store

# Per-skill scan outputs are regenerated on demand; only the tracked
# effectiveness meta under reports/_meta/ is committed (see README.md).
/reports/*
!/reports/_meta/
# The active portability program's acceptance evidence is durable input to
# independent verification, not a regenerable per-skill scan byproduct.
!/reports/portable-skill-ecosystem-completion/

# Skill-effectiveness telemetry — the raw log and gzipped archives carry
# repo-local paths and override strings (see .claude/skill-use/README.md).
# The summarized lessons-*.md digest stays tracked.
.claude/skill-use/log.jsonl
.claude/skill-use/archive/log-*.jsonl.gz

# skill-comply harness scorecards are regenerated byproducts of
# scripts/skill_comply/validate.py and carry absolute local paths
# (see scripts/skill_comply/DESIGN.md).
scripts/skill_comply/fixtures/*/conformance.json

# Machine-local agent rules (see CLAUDE.md preamble)
.claude/CLAUDE.local.md
